<?xml version="1.0" encoding="utf-8"?>
<!-- (1.6) Nút CHÍNH "Kết nối": cao 52dp, bo 14dp, nhấn TÍM #6d5efc (bảng màu hiện có của app). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A3560" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF5B4CE0" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#FF5B4CE0"
                android:startColor="#FF7A6BFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
