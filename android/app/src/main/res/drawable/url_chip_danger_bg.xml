<?xml version="1.0" encoding="utf-8"?>
<!-- (1.6) Chip "Đăng xuất": viền + nền ĐỎ NHẠT, chữ #ff8f8f (không dùng đỏ đặc để không phải "nút nguy hiểm"). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF43242C" />
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="#FF7A3A46" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2C1A20" />
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="#FF5A2E38" />
        </shape>
    </item>
</selector>
