<?xml version="1.0" encoding="utf-8"?>
<!-- (1.6) Chip phụ (Cài đặt / Chẩn đoán): nền #16202f, viền mảnh, bo tròn kiểu "viên thuốc". -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1E2B3D" />
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="#FF3A4A63" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF111A27" />
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="#FF202C3D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF16202F" />
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="#FF2A3850" />
        </shape>
    </item>
</selector>
