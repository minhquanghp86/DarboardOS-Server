<?xml version="1.0" encoding="utf-8"?>
<!-- (28/11/2026) GD16 — màn CHẨN ĐOÁN: 5 giá trị đang dùng + log vòng 300 dòng ([nav]/[promote]/[login]/[api])
     để người dùng bấm "Sao chép" gửi hỗ trợ mà KHÔNG cần adb. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B1220"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diag_title"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/diag_hint"
        android:textColor="#FF9AA7BD"
        android:textSize="11sp" />

    <!-- 5 giá trị: domain · webUrl đang dùng · URL hiện tại của WebView · cookie ingress_session · token ingress -->
    <TextView
        android:id="@+id/diagValues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#FF16202F"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:textColor="#FFC7D2E2"
        android:textIsSelectable="true"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/diag_log_section"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/diagScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="#FF16202F"
        android:fillViewport="true">

        <TextView
            android:id="@+id/diagLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="#FFC7D2E2"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/diagCopyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/diag_copy" />

        <Button
            android:id="@+id/diagShareButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/diag_share" />

        <Button
            android:id="@+id/diagClearButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/diag_clear" />
    </LinearLayout>

    <Button
        android:id="@+id/diagCloseButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="48dp"
        android:text="@string/action_close" />

</LinearLayout>
