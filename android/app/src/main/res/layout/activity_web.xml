<?xml version="1.0" encoding="utf-8"?>
<!--
  (14/11/2026) GD7 — màn WebView + THANH THÔNG BÁO ĐĂNG NHẬP Home Assistant.

  (18/11/2026) GD10 — thanh thông báo thành 2 dòng (cao theo nội dung thay vì 40dp cố định):
    dòng 1 "Đăng nhập Home Assistant để tiếp tục" + DÒNG CHẨN ĐOÁN `[login] cookie=… web=…`
    (đúng như dòng ghi ra Logcat, để chẩn đoán ngay trên máy thật),
    dòng 2 ba nút: "Mở Dashboard" (LUÔN hiện — người dùng chủ động, phòng khi tự dò trượt),
    "Thử lại" (chỉ hiện khi tự dò thất bại) và "Tôi đã đăng nhập".

  Bar nằm trong luồng layout nên ĐẨY WebView xuống, KHÔNG che nội dung trang.
  FrameLayout `webHost` (weight 1) — WebView full phần còn lại + **BONG BÓNG 44dp KÉO ĐƯỢC** (`urlBubble`, 1.7:
  icon bánh răng thay chữ "URL", dời được khắp màn hình và nhớ vị trí — xem khối chú thích ngay trên ImageView).

  (1.5) **THANH NÀY MẶC ĐỊNH `gone` VÀ CHỈ ĐƯỢC BẬT KHI THẬT SỰ CẦN ĐĂNG NHẬP** — mọi lần đổi visibility đi qua
  `MainActivity.showLoginBar(show, reason)` + chính sách `LoginBar` (đã có phiên `ingress_session` thì KHÔNG bao giờ
  hiện; "chưa biết trạng thái" cũng không hiện). Nhờ vậy lần mở app sau (đã đăng nhập) không còn cảnh thanh hiện
  1–2 giây rồi tự ẩn, và WebView không bị đẩy xuống rồi kéo lên.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/haLoginBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF16202F"
        android:minHeight="40dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/haLoginText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="5"
            android:text="@string/ha_login_banner"
            android:textColor="#FFE8EEF7"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="end"
            android:orientation="horizontal">

            <!-- (18/11/2026) GD10 — LUÔN hiện ở màn đăng nhập: người dùng tự mở dashboard khi auto-detect trượt. -->
            <Button
                android:id="@+id/haDashboardButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/ha_login_button_bg"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/ha_dashboard_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />

            <!-- (18/11/2026) GD10 — chỉ hiện khi tự dò thất bại (hết biến thể URL mà vẫn 401). -->
            <Button
                android:id="@+id/haRetryButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/ha_login_button_bg"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/ha_retry_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- (14/11/2026) GD7 — dự phòng khi không dò được cookie (trình duyệt nhúng không ghi cookie...). -->
            <Button
                android:id="@+id/haLoginDoneButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/ha_login_button_bg"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/ha_login_done"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/webHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- (1.7) **BONG BÓNG “KẾT NỐI” KÉO ĐƯỢC** — thay hẳn nút tròn chữ “URL” cố định ở góc.

             Vì sao phải đổi: nút cũ nằm ĐÈ lên nội dung một số trang (góc phải trên là chỗ các trang đặt nút riêng),
             không dời được, và chữ “URL” ở 44dp gần như không đọc được khi alpha 0.55.

               • 44dp, icon bánh răng trắng (@drawable/ic_bubble_settings) trên nền tròn @drawable/url_button_bg
                 (#CC16202F + viền mảnh #55FFFFFF) — KHÔNG còn chữ;
               • KÉO TỰ DO trong `webHost` (MainActivity: onTouchListener → ACTION_DOWN ghi offset, ACTION_MOVE cập nhật
                 margin, ACTION_UP phân biệt TAP < 8dp & < 200 ms với KÉO; xem BubbleDrag);
               • vị trí nhớ theo TỈ LỆ 0..1 trong Prefs (`bubble_x`, `bubble_y`), khôi phục khi mở lại;
                 chưa có ⇒ góc phải trên, cách mép 12dp, dưới status bar;
               • alpha 0.55 khi rảnh, 0.85 khi kéo, 0.4 sau 5 s không chạm — KHÔNG BAO GIỜ tự ẩn;
                 elevation + bringToFront() ⇒ luôn nằm TRÊN WebView;
               • chỉ 44dp nên KHÔNG cản cuộn trang (sự kiện chạm ngoài bong bóng vẫn tới WebView bình thường).

             `layout_gravity="top|start"` + margin đặt LÚC CHẠY (margin mặc định 12dp/12dp trùng vị trí mặc định, để
             khung hình đầu tiên trước khi có kích thước không nhảy). `visibility="invisible"` trong XML để KHÔNG có
             khung hình nào bong bóng hiện sai chỗ: MainActivity bật `VISIBLE` ngay sau lần đặt vị trí đầu tiên
             (`applyBubblePos`). -->
        <ImageView
            android:id="@+id/urlBubble"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/url_button_bg"
            android:contentDescription="@string/action_change_url"
            android:elevation="8dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_bubble_settings"
            android:visibility="invisible" />

    </FrameLayout>

</LinearLayout>
