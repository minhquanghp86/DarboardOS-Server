<?xml version="1.0" encoding="utf-8"?>
<!--
  (17/11/2026) GD9 — MÀN NHẬP **MỘT Ô** ĐỊA CHỈ.
    "Địa chỉ Home Assistant"  -> người dùng nhập domain (vd hass.mqsmarthome.io.vn) HOẶC IP LAN (vd 192.168.10.2).
    App tự suy ra cả TRANG ĐIỀU KHIỂN (WebView) và GỐC API (/app/register, /app/incoming…):
      - domain -> https://<domain>/api/hassio_ingress/<TOKEN>/… cho CẢ HAI (API kèm cookie phiên HA),
      - IP LAN -> http://<ip>:18080 cho cả hai (cảnh báo: không có micro/camera vì cần HTTPS).
  Ô thứ hai ("Máy chủ API (LAN)") đã bỏ khỏi giao diện; dữ liệu cũ trong Prefs vẫn được đọc để điền sẵn.
  Bọc ScrollView để máy nhỏ / xoay ngang vẫn thấy hết các nút.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B1220"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- ── Ô DUY NHẤT: địa chỉ Home Assistant (domain hoặc IP LAN) ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/url_hint_web"
            android:textColor="#FFC7D2E2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/webInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autofillHints="url"
            android:background="#FF16202F"
            android:hint="@string/url_hint_web_example"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:minHeight="52dp"
            android:padding="12dp"
            android:selectAllOnFocus="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF5B6B85"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/url_web_hint"
            android:textColor="#FF7D8CA3"
            android:textSize="11sp" />

        <!-- Trạng thái: đã kết nối / đang dò (1/3) / danh sách đã thử + gợi ý / cảnh báo không có micro. -->
        <TextView
            android:id="@+id/urlStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#FF9AA7BD"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="54dp"
            android:text="@string/action_connect"
            android:textSize="16sp" />

        <!-- (10/11/2026) GD2: mo man Cai dat (nhan cuoc goi khi app dong, quyen thong bao, toi uu pin). -->
        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="@string/action_settings"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/url_footer"
            android:textColor="#FF5B6B85"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
