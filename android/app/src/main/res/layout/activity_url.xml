<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B1220"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/url_hint"
        android:textColor="#FF9AA7BD"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/urlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:autofillHints="url"
        android:background="#FF16202F"
        android:hint="@string/url_hint"
        android:imeOptions="actionGo"
        android:inputType="textUri"
        android:maxLines="3"
        android:minHeight="52dp"
        android:padding="12dp"
        android:selectAllOnFocus="true"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#FF5B6B85"
        android:textSize="15sp" />

    <Button
        android:id="@+id/openButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="54dp"
        android:text="@string/action_open"
        android:textSize="16sp" />

    <!-- (10/11/2026) GD2: mo man Cai dat (nhan cuoc goi khi app dong, quyen thong bao, toi uu pin). -->
    <Button
        android:id="@+id/settingsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:text="@string/action_settings"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/url_footer"
        android:textColor="#FF5B6B85"
        android:textSize="12sp" />

</LinearLayout>
