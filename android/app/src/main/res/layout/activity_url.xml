<?xml version="1.0" encoding="utf-8"?>
<!--
  (13/11/2026) GD6 — màn nhập HAI Ô:
    1. "Trang điều khiển (https)"  -> webUrl cho WebView (ingress HA, cần https để có micro/camera),
    2. "Máy chủ API (LAN)"         -> apiBase cho PhoneService/register/incoming/answer/decline.
  Bọc ScrollView để máy nhỏ / xoay ngang vẫn thấy hết các nút.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B1220"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- ── Ô 1: trang điều khiển (https) ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/url_hint_web"
            android:textColor="#FFC7D2E2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/webInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autofillHints="url"
            android:background="#FF16202F"
            android:hint="@string/url_hint_web_example"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:maxLines="1"
            android:minHeight="52dp"
            android:padding="12dp"
            android:selectAllOnFocus="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF5B6B85"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/url_web_hint"
            android:textColor="#FF7D8CA3"
            android:textSize="11sp" />

        <!-- ── Ô 2: máy chủ API (LAN) ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/url_hint_api"
            android:textColor="#FFC7D2E2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/apiInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autofillHints="url"
            android:background="#FF16202F"
            android:hint="@string/url_hint_api_example"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:minHeight="52dp"
            android:padding="12dp"
            android:selectAllOnFocus="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF5B6B85"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/url_api_hint"
            android:textColor="#FF7D8CA3"
            android:textSize="11sp" />

        <!-- Trạng thái: đã kết nối / đang dò (1/3) / danh sách đã thử + gợi ý. -->
        <TextView
            android:id="@+id/urlStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#FF9AA7BD"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="54dp"
            android:text="@string/action_connect"
            android:textSize="16sp" />

        <!-- (10/11/2026) GD2: mo man Cai dat (nhan cuoc goi khi app dong, quyen thong bao, toi uu pin). -->
        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="@string/action_settings"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/url_footer"
            android:textColor="#FF5B6B85"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
