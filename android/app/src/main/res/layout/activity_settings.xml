<?xml version="1.0" encoding="utf-8"?>
<!-- (11/11/2026) GD3 — man Cai dat: bat/tat nhan cuoc goi khi app dong, quyen, loi tat cai dat MIUI, trang thai debug. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B1220"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/receiveSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:minHeight="48dp"
            android:text="@string/st_receive"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/st_receive_hint"
            android:textColor="#FF9AA7BD"
            android:textSize="12sp" />

        <!-- ── trạng thái (debug): cuộc gọi đang đến / chuông / lần poll cuối ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/st_status_section"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FF16202F"
            android:padding="12dp"
            android:textColor="#FF9AA7BD"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/st_targets_section"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- (13/11/2026) GD6: 2 giá trị đang dùng — webUrl (WebView) và apiBase (API LAN). -->
        <TextView
            android:id="@+id/targetsView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FF16202F"
            android:padding="12dp"
            android:textColor="#FF9AA7BD"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <!-- (13/11/2026) GD6: đăng nhập Home Assistant một lần (cookie giữ cho các lần sau). -->
        <Button
            android:id="@+id/haLoginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="@string/st_ha_login_button" />

        <Button
            android:id="@+id/haHomeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/st_ha_home_button" />

        <!-- (14/11/2026) GD7 — trạng thái phiên HA (dò cookie) + "Đăng nhập lại Home Assistant". -->
        <TextView
            android:id="@+id/haStatusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FF16202F"
            android:padding="12dp"
            android:textColor="#FFC7D2E2"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <Button
            android:id="@+id/haReloginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/st_ha_relogin_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/st_ha_relogin_hint"
            android:textColor="#FF9AA7BD"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/st_ha_login_hint"
            android:textColor="#FF9AA7BD"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/st_token_section"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FF16202F"
            android:hint="@string/st_token_hint_example"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF5B6B85"
            android:textSize="13sp" />

        <Button
            android:id="@+id/saveTokenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/st_token_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/st_token_hint"
            android:textColor="#FF9AA7BD"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/st_permissions"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/notifButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="@string/st_notif_button" />

        <Button
            android:id="@+id/batteryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/st_battery_button" />

        <Button
            android:id="@+id/fullScreenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/st_full_button" />

        <Button
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/st_overlay_button" />

        <Button
            android:id="@+id/dndButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/st_dnd_button" />

        <!-- ── cài đặt thông báo + lối tắt MIUI ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/st_device_section"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/st_device_hint"
            android:textColor="#FF9AA7BD"
            android:textSize="12sp" />

        <Button
            android:id="@+id/notifSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="@string/st_notif_settings_button" />

        <Button
            android:id="@+id/callChannelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/st_call_channel_button" />

        <!-- (12/11/2026) GD5: chuông/rung do kênh "Cuộc gọi đến" phát -> chọn nhạc chuông tại đây. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/st_call_channel_hint"
            android:textColor="#FF9AA7BD"
            android:textSize="12sp" />

        <Button
            android:id="@+id/miuiAutostartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/st_miui_autostart_button" />

        <Button
            android:id="@+id/miuiPermButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/st_miui_perm_button" />

        <Button
            android:id="@+id/appDetailsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/st_app_details_button" />

        <Button
            android:id="@+id/closeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:minHeight="52dp"
            android:text="@string/action_close" />

    </LinearLayout>
</ScrollView>
