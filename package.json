{
  "name": "remotewebviewserver",
  "version": "2.9.224",
  "type": "module",
  "license": "Apache-2.0 AND MIT",
  "author": "minhquanghp86",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhquanghp86/DarboardOS-Server.git"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && esbuild src/shell/main.ts --bundle --format=iife --target=chrome120 --minify --outfile=dist/shell.bundle.js",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "licenses": "node scripts/gen-third-party.mjs",
    "check:spdx": "node scripts/check-spdx.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "devtools-protocol": "^0.0.1510116",
    "env-var": "^7.5.0",
    "hls.js": "^1.6.15",
    "ical.js": "^2.2.1",
    "mpegts.js": "^1.8.0",
    "playwright-core": "1.55.0",
    "shaka-player": "^4.16.51",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "webworkify-webpack": "2.1.5"
  }
}
